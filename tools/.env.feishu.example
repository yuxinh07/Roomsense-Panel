# 飞书凭证模板 —— 复制为 .env.feishu 后填真实值
#   cp tools/.env.feishu.example tools/.env.feishu
#
# .env.feishu 已在 .gitignore 中，不会被提交到 GitHub。
# 这个文件本身（.example）可以安全提交。

# ── 必填 ──
# 飞书开放平台 → 企业自建应用 → 凭证与基础信息
FEISHU_APP_ID=cli_xxxxxxxxxxxxxxxx
FEISHU_APP_SECRET=

# 多维表 URL：https://xxx.feishu.cn/base/BascnXXXXXXXX?table=tblYYYYYYYY
FEISHU_TABLE_TOKEN=BascnXXXXXXXXXXXXXXXX
FEISHU_TABLE_ID=tblXXXXXXXXXXXXXXXX

# ── 可选：其它三张表，留空则不同步 ──
FEISHU_TABLE_ID_INV=tblXXXXXXXXXXXXXXXX
FEISHU_TABLE_ID_ADS=tblXXXXXXXXXXXXXXXX
FEISHU_TABLE_ID_SKU=tblXXXXXXXXXXXXXXXX

# ── 后台写操作口令，自己定一个 ──
ADMIN_TOKEN=Rs@2026roomsense
