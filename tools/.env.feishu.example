# 飞书凭证模板 —— 复制为 .env.feishu 后填真实值
#   cp tools/.env.feishu.example tools/.env.feishu
#
# .env.feishu 已在 .gitignore 中，不会被提交到 GitHub。
# 这个文件本身（.example）可以安全提交。

# ── 必填 ──
# 飞书开放平台 → 企业自建应用 → 凭证与基础信息
FEISHU_APP_ID=cli_xxxxxxxxxxxxxxxx
FEISHU_APP_SECRET=

# 多维表：https://my.feishu.cn/base/ImJybIKBlauxp4sEdZkcPvpWn8g
# ↓ 下面 5 个已经填好了（2026-09-03 核对过表结构），一般不用改
FEISHU_TABLE_TOKEN=ImJybIKBlauxp4sEdZkcPvpWn8g
FEISHU_TABLE_ID=tblLVFcCYLwLGdun          # 销售明细
FEISHU_TABLE_ID_INV=tblHol3lES38B6HJ      # 库存
FEISHU_TABLE_ID_ADS=tbl20vkrSmu1O2pK      # 广告投放
FEISHU_TABLE_ID_SKU=tbl9CQoZ6jGqpD1a      # SKU 主数据

# 换表了就改上面这几行；只改某一张表的话，其它行留着不动

# ── 后台写操作口令，自己定一个 ──
ADMIN_TOKEN=Rs@2026roomsense
